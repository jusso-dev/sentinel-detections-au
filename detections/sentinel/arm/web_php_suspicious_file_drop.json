{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "string",
      "metadata": {
        "description": "Name of the Log Analytics workspace where Microsoft Sentinel is enabled."
      }
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'), '/alertRules/6d4e0e1b-8b6a-4f3d-9c2a-1a0b3c4d5e08')]",
      "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/6d4e0e1b-8b6a-4f3d-9c2a-1a0b3c4d5e08')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-11-01",
      "properties": {
        "displayName": "Suspicious PHP Web Shell Script Dropped into Webroot",
        "description": "Detects creation or modification of PHP or executable script files inside standard webroot directories by web server or PHP processes. ISM controls: ISM-0580, ISM-1144, ISM-1405. Advisories: acsc-2026-10-21-php-critical-vulnerabilities.",
        "severity": "High",
        "enabled": true,
        "query": "DeviceFileEvents\n| where ActionType in (\"FileCreated\", \"FileModified\")\n| where FolderPath has_any (\"/var/www/\", \"/srv/www/\", \"\\\\inetpub\\\\wwwroot\\\\\", \"/usr/share/nginx/html/\")\n| where FileName endswith \".php\" or FileName endswith \".phtml\" or FileName endswith \".phar\"\n| where InitiatingProcessFileName has_any (\"php\", \"httpd\", \"apache2\", \"nginx\", \"w3wp.exe\")\n| project Timestamp, DeviceId, DeviceName, InitiatingProcessFileName, FolderPath, FileName, SHA256, ReportId",
        "queryFrequency": "PT1H",
        "queryPeriod": "PT1H",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT5H",
        "suppressionEnabled": false,
        "tactics": [
          "Persistence"
        ],
        "techniques": [
          "T1505"
        ],
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "subTechniques": [
          "T1505.003"
        ],
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "DeviceName"
              }
            ]
          },
          {
            "entityType": "File",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "FileName"
              }
            ]
          }
        ]
      }
    }
  ]
}
