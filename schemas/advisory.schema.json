{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jusso-dev/sentinel-detections-au/schemas/advisory.schema.json",
  "title": "ASD/ACSC Advisory Record",
  "description": "Structured metadata record for an ASD/ACSC advisory or alert, containing an original summary, canonical cyber.gov.au link, MITRE ATT&CK techniques, affected products, optional published IOCs, ISM controls and linked detections.",
  "type": "object",
  "required": [
    "id",
    "title",
    "date",
    "source",
    "link",
    "status",
    "needs_human_review",
    "summary",
    "attack_techniques",
    "affected_products",
    "iocs",
    "ism_controls",
    "linked_detections",
    "attribution"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{3,120}$",
      "description": "Unique lowercase slug identifier for the advisory record."
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 240,
      "description": "Headline of the ASD/ACSC advisory or alert."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 publication date (YYYY-MM-DD)."
    },
    "source": {
      "type": "string",
      "enum": ["advisories", "alerts", "threats"],
      "description": "ASD/ACSC feed category."
    },
    "link": {
      "type": "string",
      "pattern": "^https://www\\.cyber\\.gov\\.au/.+",
      "description": "Canonical cyber.gov.au URL for the official publication."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "mapped", "not_applicable"],
      "description": "Workflow state of this advisory record."
    },
    "needs_human_review": {
      "type": "boolean",
      "description": "True when generated automatically or awaiting analyst verification."
    },
    "summary": {
      "type": "string",
      "minLength": 30,
      "maxLength": 2000,
      "description": "Concise summary written in our own words in plain Australian English."
    },
    "attack_techniques": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^T\\d{4}(?:\\.\\d{3})?$"
      },
      "description": "MITRE ATT&CK Enterprise technique and sub-technique IDs."
    },
    "affected_products": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      },
      "description": "Software, operating systems, cloud services or appliances affected."
    },
    "cves": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CVE-\\d{4}-\\d{4,}$"
      },
      "description": "Optional CVE identifiers referenced in the publication."
    },
    "iocs": {
      "type": "object",
      "required": ["published"],
      "additionalProperties": false,
      "properties": {
        "published": {
          "type": "boolean",
          "description": "Whether the official advisory includes public indicators of compromise."
        },
        "ips": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "domains": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "urls": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "hashes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{32,64}$"
          }
        },
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "ism_controls": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ISM-\\d{4}$"
      },
      "description": "Relevant ASD Information Security Manual (ISM) control identifiers."
    },
    "linked_detections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      },
      "description": "Identifiers or relative paths of detections and hunting queries covering this advisory."
    },
    "attribution": {
      "type": "string",
      "minLength": 10,
      "description": "Source attribution referencing Commonwealth of Australia / ASD without implying endorsement."
    },
    "extraction_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extracted_at": { "type": "string" },
        "method": {
          "type": "string",
          "enum": ["manual", "deterministic", "deterministic_plus_llm"]
        },
        "llm_assisted": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
