{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jusso-dev/sentinel-detections-au/schemas/defender-xdr-rule.schema.json",
  "title": "Rendered Microsoft Defender XDR Custom Detection Rule (Microsoft Graph detectionRule)",
  "type": "object",
  "required": [
    "@odata.type",
    "displayName",
    "isEnabled",
    "queryCondition",
    "schedule",
    "detectionAction"
  ],
  "additionalProperties": false,
  "properties": {
    "@odata.type": { "const": "#microsoft.graph.security.detectionRule" },
    "displayName": { "type": "string", "minLength": 5, "maxLength": 160 },
    "isEnabled": { "type": "boolean" },
    "queryCondition": {
      "type": "object",
      "required": ["queryText"],
      "additionalProperties": false,
      "properties": {
        "queryText": { "type": "string", "minLength": 15 }
      }
    },
    "schedule": {
      "type": "object",
      "required": ["period"],
      "additionalProperties": false,
      "properties": {
        "period": {
          "type": "string",
          "enum": ["0", "1H", "3H", "12H", "24H"]
        }
      }
    },
    "detectionAction": {
      "type": "object",
      "required": ["alertTemplate", "organizationalScope", "responseActions"],
      "additionalProperties": false,
      "properties": {
        "alertTemplate": {
          "type": "object",
          "required": [
            "title",
            "description",
            "severity",
            "category",
            "mitreTechniques",
            "recommendedActions",
            "impactedAssets"
          ],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "minLength": 5 },
            "description": { "type": "string", "minLength": 20 },
            "severity": {
              "type": "string",
              "enum": ["informational", "low", "medium", "high"]
            },
            "category": { "type": "string", "minLength": 2 },
            "mitreTechniques": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^T\\d{4}(?:\\.\\d{3})?$" }
            },
            "recommendedActions": { "type": "string", "minLength": 10 },
            "impactedAssets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["@odata.type", "identifier"],
                "additionalProperties": false,
                "properties": {
                  "@odata.type": {
                    "type": "string",
                    "enum": [
                      "#microsoft.graph.security.impactedDeviceAsset",
                      "#microsoft.graph.security.impactedUserAsset",
                      "#microsoft.graph.security.impactedMailboxAsset"
                    ]
                  },
                  "identifier": { "type": "string" }
                }
              }
            }
          }
        },
        "organizationalScope": { "type": "null" },
        "responseActions": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
