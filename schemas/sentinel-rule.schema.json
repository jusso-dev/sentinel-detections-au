{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jusso-dev/sentinel-detections-au/schemas/sentinel-rule.schema.json",
  "title": "Rendered Microsoft Sentinel Scheduled Analytics Rule YAML",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "severity",
    "status",
    "kind",
    "queryFrequency",
    "queryPeriod",
    "triggerOperator",
    "triggerThreshold",
    "tactics",
    "relevantTechniques",
    "query",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": { "type": "string", "minLength": 5 },
    "description": { "type": "string", "minLength": 20 },
    "severity": {
      "type": "string",
      "enum": ["Informational", "Low", "Medium", "High"]
    },
    "status": {
      "type": "string",
      "enum": ["Available", "Experimental", "Deprecated"]
    },
    "kind": { "const": "Scheduled" },
    "requiredDataConnectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["connectorId", "dataTypes"],
        "properties": {
          "connectorId": { "type": "string" },
          "dataTypes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "queryFrequency": { "type": "string", "pattern": "^P(?:\\d+D|T\\d+[HM])$" },
    "queryPeriod": { "type": "string", "pattern": "^P(?:\\d+D|T\\d+[HM])$" },
    "triggerOperator": { "type": "string", "enum": ["gt", "lt", "eq", "ne"] },
    "triggerThreshold": { "type": "integer", "minimum": 0 },
    "tactics": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "relevantTechniques": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^T\\d{4}(?:\\.\\d{3})?$" }
    },
    "query": { "type": "string", "minLength": 15 },
    "entityMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entityType", "fieldMappings"],
        "properties": {
          "entityType": { "type": "string" },
          "fieldMappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["identifier", "columnName"],
              "properties": {
                "identifier": { "type": "string" },
                "columnName": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "customDetails": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
  }
}
